# Copy this file to .env.local (which is gitignored) and fill in your real key.

# Get a free access key at https://web3forms.com — just enter your email,
# no account/signup needed, and the key arrives instantly by email.
# This powers the contact form on the site: submissions get emailed straight
# to that address, with no backend server required.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here
